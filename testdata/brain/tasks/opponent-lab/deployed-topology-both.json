          "protocol": "http"
        }
      ],
      "bootstrap": {
        "timeout": "60s",
        "files": [
          {
            "path": "/usr/share/nginx/html/status.txt",
            "content": "{{task.recon}}",
            "mode": "0644"
          }
        ]
      }
    },
