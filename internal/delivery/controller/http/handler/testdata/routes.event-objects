POST   /api/events/:id/teams/:teamID/join-code | object(team) | :teamID,object(team)
POST   /api/events/:id/teams/:teamID/members/:userID/kick | object(team) | :teamID,:userID,object(team)
GET    /api/events/:id/teams/challenges/:challengeID/files/:fileID | event(:id) | :challengeID,:fileID
POST   /api/events/:id/teams/challenges/:challengeID/hints/:hintID/unlock | event(:id) | :challengeID,:hintID
GET    /api/events/:id/teams/challenges/:challengeID/lab | event(:id) | :challengeID
